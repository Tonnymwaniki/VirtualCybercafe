# Copy this file to .env and fill in what you have. Restart `npm start` after
# changing it. Anything left empty runs in demo mode.

# AI attendant and CV writer (server only). Key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-4-5 (cheapest). For smarter answers: claude-sonnet-5-5
# ANTHROPIC_MODEL=
# Daily AI limits: requests per phone (default 40), and total spend in US dollars (default 1).
# AI_DAILY_LIMIT=40
# AI_DAILY_BUDGET_USD=1
# The hosted app answers AI requests only for signed-in users. 1 = always
# require sign-in, 0 = never. Unset: required on the hosted app only.
# AI_REQUIRE_SIGN_IN=1
# Secret for /api/usage?key=... on the hosted app.
# USAGE_KEY=

# Version one shows only Jobs & CV, Documents and your account; the other
# services say "Coming soon". Set to 1 to switch them all on while developing.
# EXPO_PUBLIC_FULL_APP=1

# Accounts and Digital Locker. From your Supabase project: Settings > API.
# These two are safe to ship in the app; the database rules protect the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Print at any cyber. The web address where the app is hosted, used in print
# QR codes (e.g. https://virtualcybercafe.expo.app). Empty while developing:
# codes then point to this computer's development server.
# EXPO_PUBLIC_SITE_URL=
